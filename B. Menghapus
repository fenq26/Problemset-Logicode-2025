#include <bits/stdc++.h>
using namespace std;

#define GRIND ios_base::sync_with_stdio(0); cin.tie(0); cout.tie(0);

#define int long long

const int INF = 1e18;

#define all(v) ((v).begin()), ((v).end())
#define AllR(v) ((v).rbegin()), ((v).rend())

signed main() {
    GRIND

    int n; 
    cin >> n;

    vector<int> a(2 * n);
    for (int i = 0; i < 2 * n; i++) cin >> a[i];

    sort(all(a));  

    int ans = INF;
    for (int i = 0; i + n - 1 < 2 * n; i++) {
