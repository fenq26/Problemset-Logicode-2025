#include <bits/stdc++.h>
using namespace std;

#define ll long long

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    vector<ll> A(n), B(n);
    for (auto &x : A) cin >> x;
    for (auto &x : B) cin >> x;

    vector<ll> delta(n);
    for (int i = 0; i < n; i++) {
        delta[i] = B[i] - A[i];
    }

    ll total = accumulate(delta.begin(), delta.end(), 0LL);

    // ===== CASE n = 1 =====
    if (n == 1) {
        if (delta[0] < 0) {
            cout << -1;
        } else {
            cout << delta[0] << '\n';
            int limit = min((ll)1e5, delta[0]);
            for (int i = 0; i < limit; i++) cout << 1 << " ";
        }
        return 0;
    }

    // ===== CASE n = 2 =====
    if (n == 2) {
        if (total != 0) {
            cout << -1;
            return 0;
        }

        ll need = abs(delta[0]);
        cout << need << '\n';

        int pos = (A[0] < B[0] ? 1 : 2);
        for (int i = 0; i < min((ll)1e5, need); i++) {
            cout << pos << " ";
        }
        return 0;
    }

    // ===== GENERAL CASE =====
    ll step = -1;
    if (total % (2 - n) == 0) {
        step = total / (2 - n);
    }

    bool valid = true;
    for (int i = 0; i < n; i++) {
        ll val = delta[i] + step;
        if (step < 0 || val < 0 || val % 2 != 0) {
            valid = false;
            break;
        }
    }

    if (!valid) {
        cout << -1;
        return 0;
    }

    cout << step << '\n';

    int printed = 0;
    for (int i = 0; i < n && printed < 100000; i++) {
        ll cnt = (delta[i] + step) / 2;
        while (cnt-- > 0 && printed < 100000) {
            cout << i + 1 << " ";
            printed++;
        }
    }

    return 0;
}
