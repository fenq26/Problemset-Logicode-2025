} 

void solve() {
    int n; 
    cin >> n; 
    
    vector<int> p(n), v(n);
    for(int i = 0; i < n; i++) {
        int x; 
        cin >> x;
        p[i] = v[i] = x; 
    }
    
    sort(v.begin(), v.end());
    
    for(int i = 0; i < n; i++) {
        int l = lower_bound(v.begin(), v.end(), p[i]) - v.begin() + 1; 
        int r = upper_bound(v.begin(), v.end(), p[i]) - v.begin();      
        
        cout << l << " " << r << '\n';  
    }
}

signed main() {
    ios::sync_with_stdio(false);
